# mitlist environment configuration
# Copy this file to .env and fill in the values.

# ============================================
# Required
# ============================================

# PostgreSQL connection string
DATABASE_URL=

# JWT signing secret (min 32 characters)
SECRET_KEY=

# Session/cookie signing secret (min 32 characters)
SESSION_SECRET_KEY=

# ============================================
# Database & Cache
# ============================================

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis password (leave empty if no auth)
REDIS_PASSWORD=

# ============================================
# Application
# ============================================

# Environment: development | staging | production
ENVIRONMENT=development

# Frontend URL used for OAuth redirects and email links
FRONTEND_URL=http://localhost:5173

# API route prefix
API_PREFIX=/api

# JWT access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Run database migrations automatically on startup
RUN_MIGRATIONS_ON_STARTUP=true

# Pre-warm user caches on startup
WARM_CACHE_ON_STARTUP=false

# Logging level: DEBUG | INFO | WARNING | ERROR | FATAL
LOG_LEVEL=WARNING

# ============================================
# OAuth — Google
# ============================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ============================================
# OAuth — Apple
# ============================================

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://mitlistbe.mohamad.dev/api/v1/auth/apple/callback

# Comma-separated list of allowed OAuth redirect URIs
OAUTH_REDIRECT_ALLOWLIST=

# ============================================
# External APIs
# ============================================

# CrofAI API key (OCR scanner — structured JSON extraction)
CROFAI_API_KEY=

# OpenRouter API key (OCR / plant tips / identification)
OPENROUTER_API_KEY=

# Gemini API key (AI features — optional)
GEMINI_API_KEY=

# OpenRouter base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Web Push VAPID keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:noreply@mitlist.app

# Resend (transactional emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Sentry error tracking
SENTRY_DSN=

# ============================================
# File Storage (S3 or S3-compatible)
# ============================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_ENDPOINT_URL=

# ============================================
# Limits
# ============================================

MAX_ACTIVE_LISTS_PER_GROUP=100
MAX_ITEMS_PER_LIST=1000
MAX_FILE_SIZE_MB=10
MAX_FILE_SIZE_BYTES=52428800
MAX_STORAGE_PER_GROUP_GB=10

# ============================================
# Feature Flags
# ============================================

ENABLE_VIRUS_SCANNING=false
VIRUS_SCANNER_ENDPOINT=
ENABLE_CONTENT_SCANNING=true
