# mitlist environment configuration
# Copy this file to .env and fill in the values.

# ============================================
# Required
# ============================================

# PostgreSQL connection string.
# For the bundled docker compose db service use:
#   postgres://mitlist:mitlist@localhost:5432/mitlist?sslmode=disable
DATABASE_URL=

# JWT signing secret (min 32 characters). Generate with:
#   openssl rand -base64 32
SECRET_KEY=

# Session/cookie signing secret (min 32 characters). Must differ from
# SECRET_KEY. Generate with:
#   openssl rand -base64 32
SESSION_SECRET_KEY=

# ============================================
# Application
# ============================================

# Environment: development | staging | production
ENVIRONMENT=development

# Frontend URL used for OAuth redirects and email links
FRONTEND_URL=http://localhost:5173

# API route prefix
API_PREFIX=/api

# JWT access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Run database migrations automatically on startup
RUN_MIGRATIONS_ON_STARTUP=true

# Logging level: DEBUG | INFO | WARNING | ERROR | FATAL
LOG_LEVEL=WARNING

# ============================================
# OAuth — Google
# ============================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ============================================
# OAuth — Apple
# ============================================

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://mitlistbe.mohamad.dev/api/v1/auth/apple/callback

# Comma-separated list of allowed OAuth redirect URIs
OAUTH_REDIRECT_ALLOWLIST=

# ============================================
# Email + password sign-in
# ============================================

# The hosted service signs people in with Google or Apple only. A self-hosted
# instance usually has neither, so email + password is the door it needs: this
# turns on register, login, password reset and change-password. The app reads
# the flag from the server and shows the form only when it is on.
PASSWORD_AUTH_ENABLED=true

# Guest accounts ("continue without signing up"). Off by default: an
# unauthenticated endpoint that mints working accounts is the easiest thing
# on the API to abuse. Existing guests keep working either way; this only
# gates the creation of new ones. The app hides the guest button when off.
GUEST_AUTH_ENABLED=false

# Web Push VAPID keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:noreply@mitlist.me

# Firebase / FCM (mobile push)
# Set FIREBASE_PROJECT_ID and FIREBASE_SERVICE_ACCOUNT_JSON (raw JSON string)
# to enable FCM push to Android and iOS devices.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase App Check (attestation; opt-in for self-hosted instances)
# The official hosted API sets this to true and rejects requests that do not
# carry a valid App Check token. Keep false for a normal self-host; if you
# enable it, use your own Firebase project and build the matching client with
# --dart-define=APP_CHECK_ENABLED=true. FIREBASE_PROJECT_NUMBER is the numeric
# Firebase project number used in App Check token issuer/audience validation.
# Never use a debug provider or debug token in a release artifact.
FIREBASE_APP_CHECK_REQUIRED=false
FIREBASE_PROJECT_NUMBER=
FIREBASE_APP_CHECK_ALLOWED_APP_IDS=

# Cloudflare Turnstile secret for web guest sign-up and landing-page tester
# signups. App Check covers mobile; its only web provider is reCAPTCHA
# Enterprise, so the browser solves an invisible Turnstile challenge instead.
# Unset means both are unattested.
TURNSTILE_SECRET_KEY=

# Staffroom (reqtrack) intake. When both are set, beta-tester signups from
# the landing page are mirrored onto the team's tester list as they arrive.
# The key is mitlist's intake app key. Unset means signups stay in Postgres.
STAFFROOM_INTAKE_URL=
STAFFROOM_INTAKE_KEY=

# Amazon SES (transactional emails). Setting the region is what opts into SES
# as the primary provider — the AWS credentials below are shared with file
# storage, so their presence alone must not turn email on. Credentials come
# from the standard AWS chain (an instance/task role, or the
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY pair under "File Storage" below), and
# the identity in MAIL_FROM_EMAIL must be verified in this SES region.
# Leave empty to fall back to the SMTP providers.
AWS_SES_REGION=
# Optional SES configuration set: attach one to get bounce/complaint and open
# events published to SNS/CloudWatch. Leave empty to send without one.
AWS_SES_CONFIGURATION_SET=
# SES credentials. Deliberately separate from the AWS_* pair under "File
# Storage" below, which addresses an S3-compatible provider that may not be AWS
# at all (the hosted service points it at Cloudflare R2). Leave both empty to
# use the ambient AWS credential chain, e.g. an EC2/ECS role.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# Sender. MAIL_FROM_EMAIL must be an address on a verified SES identity (or
# the SMTP provider's verified sender). MAIL_FROM_NAME is the display name the
# inbox shows in front of it.
MAIL_FROM_EMAIL=noreply@mitlist.me
MAIL_FROM_NAME=mitlist
# Store listings the mobile-beta invitation email links to (see
# docs/testing-signups.md). Leave APP_STORE_URL empty until iOS is installable.
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=me.mitlist
APP_STORE_URL=

# Onboarding tips: a five-email series over the first month after sign-up
# (day 1, 3, 7, 14, 30), sent by an hourly job to verified, non-guest
# accounts. Every message carries an unsubscribe link and List-Unsubscribe
# headers; the link points at this API, so the series only runs when
# PUBLIC_API_URL is set to the API's public origin. Set
# ONBOARDING_EMAILS_ENABLED=false to turn it off regardless. Campaign messages
# are attempted once through one provider so a timeout or overlapping API
# replicas cannot produce duplicates.
ONBOARDING_EMAILS_ENABLED=true
PUBLIC_API_URL=

# Sentry / GlitchTip error tracking (backend).
# Leave SENTRY_DSN empty to keep error reporting OFF (the default).
# Set it to a Sentry-compatible DSN (e.g. a self-hosted GlitchTip project DSN)
# to turn on backend error reporting — no rebuild required, runtime only.
# When set, the backend reports: handled 5xx errors, service/job error logs,
# HTTP-handler and background-job panics, and startup fatals — all attributed to
# the authenticated user where known.
SENTRY_DSN=
# Release/version shown in GlitchTip. Overrides the build-time version when set.
SENTRY_RELEASE=
# Optional server/host name label attached to events.
SENTRY_SERVER_NAME=
# Performance tracing sample rate, 0.0–1.0 (0 = off, the default). GlitchTip
# supports transactions; start small (e.g. 0.05) in production.
SENTRY_TRACES_SAMPLE_RATE=0
# Verbose SDK logging for debugging the integration itself (true/false).
SENTRY_DEBUG=false

# ============================================
# File Storage (S3 or S3-compatible)
# ============================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_ENDPOINT_URL=

# ============================================
# Limits
# ============================================

MAX_ACTIVE_LISTS_PER_GROUP=100
MAX_ITEMS_PER_LIST=1000
MAX_FILE_SIZE_MB=10
MAX_FILE_SIZE_BYTES=10485760
MAX_STORAGE_PER_GROUP_GB=1

# ============================================
# Feature Flags
# ============================================

ENABLE_VIRUS_SCANNING=false
VIRUS_SCANNER_ENDPOINT=
ENABLE_CONTENT_SCANNING=true

# ============================================
# Polar (household premium billing, opt-in)
# ============================================
# Leave POLAR_WEBHOOK_SECRET empty to keep billing disabled — no premium
# gating is enforced and the webhook endpoint rejects everything.

# Organization access token (Polar dashboard → Settings → Developers).
# It needs both products:read and checkouts:write — with only the first, the
# paywall shows correct prices and then fails to open checkout, which looks
# like a server bug rather than a missing scope. Add customer_sessions:write
# for the "manage subscription" portal link.
# While this is empty, households grow without a member limit — which is the
# right default for a self-hosted instance.
POLAR_ACCESS_TOKEN=
# Signing secret for the webhook endpoint (Polar dashboard → Settings →
# Webhooks; starts with whsec_). Paste it exactly as shown — do not base64
# it, pad it or strip the prefix. Polar changed its signing key derivation
# for secrets generated from 2026-09-08 and the API accepts both vintages.
# Without it the webhook route answers 503 and no payment is ever recorded,
# so customers pay and get nothing. The endpoint must be subscribed to the
# subscription.* events plus order.paid and order.refunded.
POLAR_WEBHOOK_SECRET=
# Product IDs for the household premium plan (Monthly / Yearly). Each product
# must be Private or Public in Polar: a Draft product still prices correctly
# on the paywall but Polar refuses every checkout for it ("Product is a
# draft."), which from the app looks like checkout being broken.
POLAR_PRODUCT_ID_MONTHLY=
POLAR_PRODUCT_ID_YEARLY=
# Optional: the one-time supporter pack (badge + accent colours). Leave empty
# to not sell it — the app then unlocks the accent colours for everyone.
POLAR_PRODUCT_ID_SUPPORTER=
# Set to https://sandbox-api.polar.sh to test against Polar's sandbox.
POLAR_BASE_URL=https://api.polar.sh
# Optional: auto-apply this discount to every new checkout (a launch promo,
# say). This is the discount's UUID, not its promo code — anything else is
# ignored with a warning. Customers can always enter their own promo code at
# checkout instead, which needs no configuration here.
POLAR_DEFAULT_DISCOUNT_ID=
# Where Polar returns the customer after a successful payment.
CHECKOUT_SUCCESS_URL=https://app.mitlist.me/you

# Largest household size that stays free. Only enforced when billing is
# configured above. Existing larger households are never broken up — the limit
# only refuses new members.
FREE_MEMBER_LIMIT=4

# ---- Mobile In-App Purchase (App Store + Play Store) ----
# Native IAP is how the iOS/Android apps sell premium; Apple and Google require
# it for digital subscriptions. Independent of Polar above — a server may run
# web checkout, mobile IAP, both, or neither. Leave a block empty to disable it.
#
# Apple signed transactions and notifications are verified locally from their
# Apple certificate chain. The bundle id and both product ids enable Apple IAP.
# APPLE_IAP_ENVIRONMENT accepts Production, Sandbox, or Both. Use Both when one
# deployment receives production plus TestFlight/sandbox deliveries.
APPLE_IAP_BUNDLE_ID=
APPLE_IAP_ENVIRONMENT=Both
# Numeric Apple ID shown under App Information in App Store Connect. Required
# for Production/Both; sandbox-only development may leave it empty.
APPLE_IAP_APP_ID=
# App Store product ids, mapped to a billing interval.
APPLE_IAP_PRODUCT_MONTHLY=
APPLE_IAP_PRODUCT_YEARLY=
# Optional: the non-consumable supporter pack product id.
APPLE_IAP_PRODUCT_SUPPORTER=
#
# Google: a Play Developer API service-account JSON key (paste the whole JSON),
# plus the app's package name. RTDN notifications are re-verified against this.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Play Console subscription product id (base plans are configured below).
GOOGLE_PLAY_SUBSCRIPTION_ID=premium
# Play base-plan ids, mapped to a billing interval.
GOOGLE_PLAY_PRODUCT_MONTHLY=
GOOGLE_PLAY_PRODUCT_YEARLY=
# Optional: the Play one-time (in-app product) id of the supporter pack.
GOOGLE_PLAY_PRODUCT_SUPPORTER=
# Authenticated Pub/Sub push OIDC values. Audience must exactly match the
# --push-auth-token-audience configured on the push subscription; service
# account is the selected --push-auth-service-account email.
GOOGLE_PUBSUB_AUDIENCE=https://api.example.com/webhooks/google
GOOGLE_PUBSUB_SERVICE_ACCOUNT=

# ============================================
# Production deployment (docker compose --profile prod)
# ============================================
# NOTE: Postgres credentials for the docker compose stack do NOT live in
# this file. docker compose ${...} interpolation is sourced from the ROOT .env
# (next to docker-compose.yml) or your shell — a service-level env_file: like
# this one does not feed compose interpolation. Set the following in the root
# .env instead (see the project root .env.example):
#   POSTGRES_USER       — REQUIRED for prod, no default
#   POSTGRES_PASSWORD   — REQUIRED for prod, no default (openssl rand -base64 24)
#   POSTGRES_DB         — defaults to mitlist
#   DB_SSLMODE          — set to require if DATABASE_URL points at a REMOTE Postgres
#
# This file (backend/.env) is the app's own runtime config (SECRET_KEY, OAuth,
# API keys, etc.). In the bundled prod profile, DATABASE_URL is assembled by
# compose from the root .env, so you do not need
# to set DATABASE_URL here when using docker compose.
# Public mobile-testing signup origin (does not grant access to account/admin routes).
TESTING_SIGNUP_ORIGIN=https://mitlist.me
