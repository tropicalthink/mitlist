# DeepSeek API — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Model for data generation (deepseek-chat is fast/cheap; deepseek-reasoner for harder batches)
# Use deepseek-chat for structured JSON/JSONL generation (reasoner may return empty content)
DEEPSEEK_MODEL=deepseek-chat

# Base URL (OpenAI-compatible)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenRouter — P3, P4, P5 — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-preview
# Optional per-prompt model override (e.g. OPENROUTER_MODEL_P5=openai/gpt-4o-mini)
# Optional OpenRouter attribution headers
# OPENROUTER_SITE_URL=https://your-site.example
OPENROUTER_APP_NAME=mitlist-intelligence

# Generation defaults
DEFAULT_TEMPERATURE=0.9
MAX_RETRIES=3
MAX_COMPLETION_TOKENS=8192
PARSE_RETRIES=2
MIN_ALIASES=12
REQUEST_TIMEOUT=300

# Parallel batch workers (default 8; turbo mode defaults to 20)
BATCH_WORKERS=8

# Turbo: split P3/P5 into small chunks + more workers (~1h P5 instead of ~8h)
TURBO_MODE=1
TURBO_CHUNK_SIZE=100
TURBO_WORKERS=12

# Max continuation calls per batch (auto-scales; override only if needed)
# MAX_CONTINUATIONS=45

# Dashboard server
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
