# DeepSeek API — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Model for data generation (deepseek-chat is fast/cheap; deepseek-reasoner for harder batches)
# Use deepseek-chat for structured JSON/JSONL generation (reasoner may return empty content)
DEEPSEEK_MODEL=deepseek-chat

# Base URL (OpenAI-compatible)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Generation defaults
DEFAULT_TEMPERATURE=0.9
MAX_RETRIES=3
MAX_COMPLETION_TOKENS=8192
PARSE_RETRIES=2
MIN_ALIASES=12
REQUEST_TIMEOUT=300

# Parallel batch workers (API calls run concurrently; 8 ≈ 8× faster for I/O-bound P2)
BATCH_WORKERS=8

# Dashboard server
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
