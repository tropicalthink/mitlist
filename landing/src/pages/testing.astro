---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site, type SiteLanguage } from "../data/site";
interface Props { language?: SiteLanguage; }
const { language = "en" } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
// Tester signups live in Staffroom (reqtrack), not the mitlist API, so the
// form talks to Cloudflare directly. The app slug identifies mitlist there.
const signupEndpoint =
  import.meta.env.PUBLIC_TESTING_SIGNUP_URL ||
  "https://reqtrack.tropicalthink.com/api/v1/intake/public/apps/mitlist-09ee/testers";
const copy = {
  en: { android: "Android? mitlist is on Google Play now: install it directly, no signup needed.", androidButton: "Get it on Google Play", title: "Get the mitlist mobile beta", description: "Join mitlist's mobile beta on Android through Google Play or on iOS through TestFlight.", beta: "Now in public beta", headline: "mitlist, in your pocket.", intro: "The web app is open now. Leave your email and we’ll send your Google Play or TestFlight invitation when your mobile beta place is ready.", steps: ["Choose your phone and leave your email.", "We’ll email your Google Play or iOS TestFlight invitation.", "Try it together. Tell us what works and what needs fixing."], web: "Use mitlist on the web now", feedback: "Feedback & roadmap", join: "Join the testing list", account: "No mitlist account needed. This signs you up for testing invitations only.", email: "Your email", hint: "For Android, use the email on your Google Play account so we can add you as a tester.", phone: "Your phone", consent: "I agree to receive the invitation and essential emails about this mobile test.", privacy: "Privacy notice", updates: "Also email me about the official launch and occasional mitlist news. Optional, and you can unsubscribe any time.", withdraw: "You can withdraw at any time using the contact in the privacy notice.", submit: "Sign me up", saving: "Saving your signup…", rate: "Please wait a few minutes before trying again.", error: "We couldn’t save your signup. Please try again in a moment.", success: "You’re on the list! We’ll email your testing invitation when your place is ready.", network: "We couldn’t reach mitlist. Check your connection and try again.", nojs: "Please enable JavaScript to submit the signup form.", challenge: "Verification is still checking your browser. Please tap “Sign me up” again in a moment." },
  de: { android: "Android? mitlist gibt es jetzt bei Google Play: direkt installieren, keine Anmeldung nötig.", androidButton: "Bei Google Play laden", title: "Die mitlist Mobile-Beta", description: "Nimm unter Android über Google Play oder unter iOS über TestFlight an der mitlist Mobile-Beta teil.", beta: "Jetzt in der öffentlichen Beta", headline: "mitlist für unterwegs.", intro: "Die Web-App ist bereits offen. Hinterlass deine E-Mail-Adresse und wir senden dir deine Google-Play- oder TestFlight-Einladung, sobald dein Platz bereit ist.", steps: ["Wähle dein Smartphone und gib deine E-Mail-Adresse an.", "Wir senden dir die Google-Play- oder TestFlight-Einladung.", "Probiert mitlist gemeinsam aus und sagt uns, was funktioniert."], web: "mitlist jetzt im Web nutzen", feedback: "Feedback & Roadmap", join: "Für die Testliste anmelden", account: "Kein mitlist-Konto nötig. Diese Anmeldung gilt nur für Testeinladungen.", email: "Deine E-Mail-Adresse", hint: "Nutze für Android die E-Mail-Adresse deines Google-Play-Kontos, damit wir dich hinzufügen können.", phone: "Dein Smartphone", consent: "Ich möchte die Einladung und notwendige E-Mails zu diesem mobilen Test erhalten.", privacy: "Datenschutzerklärung", updates: "Informiert mich außerdem über den offiziellen Start und gelegentliche mitlist-Neuigkeiten. Optional und jederzeit abbestellbar.", withdraw: "Du kannst deine Einwilligung jederzeit über den Kontakt in der Datenschutzerklärung widerrufen.", submit: "Zur Testliste", saving: "Anmeldung wird gespeichert…", rate: "Bitte warte einige Minuten und versuche es erneut.", error: "Wir konnten deine Anmeldung nicht speichern. Versuch es gleich noch einmal.", success: "Du bist auf der Liste! Wir senden deine Testeinladung, sobald dein Platz bereit ist.", network: "mitlist ist gerade nicht erreichbar. Prüfe deine Verbindung und versuche es erneut.", nojs: "Bitte aktiviere JavaScript, um das Formular abzusenden.", challenge: "Die Verifizierung prüft deinen Browser noch. Tippe gleich noch einmal auf „Zur Testliste“." },
  es: { android: "¿Android? mitlist ya está en Google Play: instálala directamente, sin apuntarte.", androidButton: "Descargar en Google Play", title: "Consigue la beta móvil de mitlist", description: "Únete a la beta móvil de mitlist en Android mediante Google Play o en iOS mediante TestFlight.", beta: "Ahora en beta pública", headline: "mitlist, en tu bolsillo.", intro: "La aplicación web ya está abierta. Déjanos tu correo y te enviaremos la invitación de Google Play o TestFlight cuando tu plaza esté lista.", steps: ["Elige tu móvil y deja tu correo.", "Te enviaremos la invitación de Google Play o TestFlight.", "Probadla juntos y contadnos qué funciona y qué falta."], web: "Usar mitlist en la web", feedback: "Opiniones y hoja de ruta", join: "Únete a la lista de pruebas", account: "No necesitas una cuenta de mitlist. Esto solo te apunta a las invitaciones de prueba.", email: "Tu correo", hint: "En Android, usa el correo de tu cuenta de Google Play para que podamos añadirte.", phone: "Tu móvil", consent: "Acepto recibir la invitación y los correos necesarios sobre esta prueba móvil.", privacy: "Aviso de privacidad", updates: "Quiero recibir también noticias sobre el lanzamiento oficial y novedades ocasionales de mitlist. Es opcional y puedes darte de baja cuando quieras.", withdraw: "Puedes retirar tu consentimiento en cualquier momento mediante el contacto del aviso de privacidad.", submit: "Apuntarme", saving: "Guardando tu solicitud…", rate: "Espera unos minutos antes de volver a intentarlo.", error: "No hemos podido guardar tu solicitud. Inténtalo de nuevo en un momento.", success: "¡Estás en la lista! Te enviaremos la invitación cuando tu plaza esté lista.", network: "No hemos podido conectar con mitlist. Comprueba tu conexión e inténtalo de nuevo.", nojs: "Activa JavaScript para enviar el formulario.", challenge: "La verificación aún está comprobando tu navegador. Vuelve a pulsar «Apuntarme» en un momento." },
  fr: { android: "Android ? mitlist est désormais sur Google Play : installez-la directement, sans inscription.", androidButton: "Télécharger sur Google Play", title: "Obtenir la bêta mobile de mitlist", description: "Rejoignez la bêta mobile de mitlist sur Android via Google Play ou sur iOS via TestFlight.", beta: "Désormais en bêta publique", headline: "mitlist, dans votre poche.", intro: "L’application Web est ouverte. Laissez votre adresse e-mail et nous enverrons votre invitation Google Play ou TestFlight dès que votre place sera prête.", steps: ["Choisissez votre téléphone et indiquez votre adresse e-mail.", "Nous enverrons votre invitation Google Play ou TestFlight.", "Essayez mitlist ensemble et dites-nous ce qui fonctionne ou manque."], web: "Utiliser mitlist sur le Web", feedback: "Retours et feuille de route", join: "Rejoindre la liste de test", account: "Aucun compte mitlist n’est nécessaire. Cette inscription concerne uniquement les invitations de test.", email: "Votre adresse e-mail", hint: "Sur Android, utilisez l’adresse de votre compte Google Play afin que nous puissions vous ajouter.", phone: "Votre téléphone", consent: "J’accepte de recevoir l’invitation et les e-mails indispensables à ce test mobile.", privacy: "Avis de confidentialité", updates: "Envoyez-moi aussi des nouvelles du lancement officiel et, occasionnellement, de mitlist. Facultatif et résiliable à tout moment.", withdraw: "Vous pouvez retirer votre consentement à tout moment via le contact indiqué dans l’avis de confidentialité.", submit: "M’inscrire", saving: "Enregistrement de votre inscription…", rate: "Veuillez patienter quelques minutes avant de réessayer.", error: "Nous n’avons pas pu enregistrer votre inscription. Réessayez dans un instant.", success: "Vous êtes sur la liste ! Nous enverrons votre invitation dès que votre place sera prête.", network: "Impossible de joindre mitlist. Vérifiez votre connexion et réessayez.", nojs: "Activez JavaScript pour envoyer le formulaire.", challenge: "La vérification analyse encore votre navigateur. Appuyez de nouveau sur « M’inscrire » dans un instant." },
  nl: { android: "Android? mitlist staat nu in Google Play: installeer direct, aanmelden is niet nodig.", androidButton: "Downloaden in Google Play", title: "Download de mobiele bèta van mitlist", description: "Doe mee aan de mobiele bèta van mitlist via Google Play op Android of TestFlight op iOS.", beta: "Nu in openbare bèta", headline: "mitlist, in je broekzak.", intro: "De webapp is nu open. Laat je e-mailadres achter en we sturen je Google Play- of TestFlight-uitnodiging zodra je plek klaar is.", steps: ["Kies je telefoon en laat je e-mailadres achter.", "We mailen je uitnodiging voor Google Play of TestFlight.", "Probeer mitlist samen en vertel wat werkt en wat beter kan."], web: "mitlist nu op het web gebruiken", feedback: "Feedback en roadmap", join: "Aanmelden voor de testlijst", account: "Geen mitlist-account nodig. Hiermee meld je je alleen aan voor testuitnodigingen.", email: "Je e-mailadres", hint: "Gebruik voor Android het e-mailadres van je Google Play-account, zodat we je kunnen toevoegen.", phone: "Je telefoon", consent: "Ik wil de uitnodiging en noodzakelijke e-mails over deze mobiele test ontvangen.", privacy: "Privacyverklaring", updates: "Mail me ook over de officiële lancering en af en toe over mitlist. Optioneel en op elk moment opzegbaar.", withdraw: "Je kunt je toestemming altijd intrekken via het contact in de privacyverklaring.", submit: "Meld me aan", saving: "Je aanmelding wordt opgeslagen…", rate: "Wacht een paar minuten voordat je het opnieuw probeert.", error: "We konden je aanmelding niet opslaan. Probeer het zo opnieuw.", success: "Je staat op de lijst! We mailen je uitnodiging zodra je plek klaar is.", network: "We konden mitlist niet bereiken. Controleer je verbinding en probeer opnieuw.", nojs: "Schakel JavaScript in om het formulier te verzenden.", challenge: "De verificatie controleert je browser nog. Tik zo meteen nog eens op ‘Meld me aan’." },
}[language];
const privacyPath = language === "de" ? "/datenschutz#testing" : "/privacy#testing";
---
<Layout title={copy.title} description={copy.description} language={language} path="/mobile-beta" localized>
  <SiteHeader language={language} languagePath="mobile-beta" />
  <main id="main-content" tabindex="-1">
    <section class="wrap testing">
      <div class="testing__intro">
        <span class="stamp">{copy.beta}</span>
        <h1 class="display">{copy.headline}</h1>
        <p class="lead">{copy.intro}</p>
        <p class="android-now"><strong>{copy.android}</strong> <a class="btn btn--primary" href={site.playStoreUrl} rel="noopener">{copy.androidButton}</a></p>
        <ol>{copy.steps.map((step) => <li>{step}</li>)}</ol>
        <a href={site.appUrl}>{copy.web}</a>
        <a href={site.feedbackUrl}>{copy.feedback}</a>
      </div>
      <form id="tester-signup" class="signup" method="post" action={signupEndpoint} data-endpoint={signupEndpoint}>
        <h2 class="h3">{copy.join}</h2>
        <p>{copy.account}</p>
        <label for="tester-email">{copy.email}</label>
        <input id="tester-email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required aria-describedby="email-hint" />
        <p id="email-hint" class="hint">{copy.hint}</p>
        <fieldset>
          <legend>{copy.phone}</legend>
          <div class="platforms">
            <label><input type="radio" name="platform" value="android" required /> Android <small>Google Play</small></label>
            <label><input type="radio" name="platform" value="ios" required /> iOS <small>TestFlight</small></label>
          </div>
        </fieldset>
        <label class="consent"><input type="checkbox" name="consent" required /><span>{copy.consent} <a href={privacyPath}>{copy.privacy}</a>.</span></label>
        <label class="consent"><input type="checkbox" name="launch_updates" /><span>{copy.updates}</span></label>
        <p class="hint">{copy.withdraw}</p>
        {turnstileSiteKey && <div id="turnstile-slot" class="turnstile"></div>}
        <button type="submit" class="btn btn--primary" disabled>{copy.submit}</button>
        <p id="signup-status" role="status" aria-live="polite" tabindex="-1"></p>
        <noscript>{copy.nojs}</noscript>
      </form>
    </section>
  </main>
  <SiteFooter language={language} languagePath="mobile-beta" />
  {turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  )}
  <script define:vars={{ siteKey: turnstileSiteKey, messages: { saving: copy.saving, rate: copy.rate, error: copy.error, success: copy.success, network: copy.network, challenge: copy.challenge } }}>
    const form = document.querySelector("#tester-signup");
    const status = document.querySelector("#signup-status");
    const button = form.querySelector('button[type="submit"]');
  button.disabled = false;
  const platform = new URLSearchParams(location.search).get("platform");
  if (platform === "android" || platform === "ios") form.querySelector(`input[value="${platform}"]`).checked = true;
  // Turnstile renders on demand through the explicit API, so the token can be
  // read at submit time and the widget reset after each single-use token.
  let widgetId = null;
  let token = "";
  const slot = document.querySelector("#turnstile-slot");
  if (siteKey && slot) {
    const deadline = Date.now() + 10000;
    const arm = () => {
      if (window.turnstile) {
        widgetId = window.turnstile.render(slot, {
          sitekey: siteKey,
          action: "testing-signup",
          callback: (solved) => { token = solved; },
          "expired-callback": () => { token = ""; },
          "error-callback": () => { token = ""; },
        });
        return;
      }
      if (Date.now() < deadline) setTimeout(arm, 150);
    };
    arm();
  }
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (button.disabled || !form.reportValidity()) return;
    if (siteKey && !token) {
      status.textContent = messages.challenge;
      status.focus();
      return;
    }
    button.disabled = true;
    form.setAttribute("aria-busy", "true");
    status.textContent = messages.saving;
    const data = new FormData(form);
    const launchUpdates = data.get("launch_updates") === "on";
    try {
      const response = await fetch(form.dataset.endpoint, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: data.get("email"), platform: data.get("platform"), consent: data.get("consent") === "on", consentVersion: "testing-invitations-v1", launchUpdates, launchConsentVersion: launchUpdates ? "launch-updates-v1" : undefined, turnstileToken: token }),
        signal: AbortSignal.timeout(15000),
      });
      if (!response.ok) {
        status.textContent = response.status === 429 ? messages.rate : messages.error;
        return;
      }
      form.reset();
      status.textContent = messages.success;
      status.focus();
    } catch {
      status.textContent = messages.network;
    } finally {
      if (widgetId !== null && window.turnstile) window.turnstile.reset(widgetId);
      token = "";
      button.disabled = false;
      form.removeAttribute("aria-busy");
    }
  });
</script>
</Layout>
<style>
  main { color: var(--ink); background: var(--paper-2); }
  .testing { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4rem); padding-block: 4rem; align-items: start; }
  .testing__intro { display: grid; gap: 1.5rem; }
  .testing__intro .stamp { justify-self: start; }
  .testing__intro .display { font-size: clamp(2.6rem, 5vw, 4rem); }
  ol { padding-left: 1.3rem; margin: 0; }
  .android-now { display: grid; gap: 0.75rem; justify-items: start; margin: 0; padding: 1rem 1.1rem; border: 2px solid var(--ink); background: var(--paper-2, var(--paper)); }
  li + li { margin-top: .75rem; }
  .signup { position: relative; display: grid; gap: 1rem; padding: clamp(1.25rem, 3vw, 2rem); border: var(--border); background: var(--paper); box-shadow: var(--shadow-lg); }
  .signup > label, legend { font-weight: 700; }
  input[type="email"] { width: 100%; min-height: 48px; padding: .75rem; border: var(--border); border-radius: 0; background: var(--paper-2); color: var(--ink); font: inherit; }
  .hint, .consent, small { font-size: .9rem; color: var(--ink-3); }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { margin-bottom: .75rem; }
  .platforms { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .platforms label { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: .25rem .5rem; border: var(--border); padding: .75rem; cursor: pointer; }
  .platforms label:has(:checked) { background: var(--orange-100); box-shadow: var(--shadow-sm); }
  small { grid-column: 2; }
  input[type="radio"], input[type="checkbox"] { accent-color: var(--orange-700); width: 20px; height: 20px; flex-shrink: 0; }
  .consent { display: flex; align-items: start; gap: .5rem; min-height: 44px; font-weight: 400 !important; }
  .turnstile { min-height: 0; }
  button { min-height: 48px; }
  button:disabled { opacity: .65; cursor: wait; }
  #signup-status:empty { display: none; }
  @media (max-width: 760px) { .testing { grid-template-columns: 1fr; padding-block: 2.5rem; } }
</style>
