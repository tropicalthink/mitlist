---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { localizedPath, site, type SiteLanguage } from "../data/site";
interface Props { home?: boolean; language?: SiteLanguage; languagePath?: string; }
const { home = false, language = "en", languagePath = "" } = Astro.props;
const homePath = localizedPath(language);
const section = home ? "" : homePath;
const labels = {
  en: { features: "Features", pricing: "Pricing", source: "Open source", open: "Open mitlist", home: "mitlist home", primary: "Primary navigation" },
  de: { features: "Funktionen", pricing: "Preise", source: "Open Source", open: "mitlist öffnen", home: "mitlist Startseite", primary: "Hauptnavigation" },
  es: { features: "Funciones", pricing: "Precios", source: "Código abierto", open: "Abrir mitlist", home: "Inicio de mitlist", primary: "Navegación principal" },
  fr: { features: "Fonctions", pricing: "Tarifs", source: "Open source", open: "Ouvrir mitlist", home: "Accueil mitlist", primary: "Navigation principale" },
  nl: { features: "Functies", pricing: "Prijzen", source: "Open source", open: "Open mitlist", home: "mitlist startpagina", primary: "Hoofdnavigatie" },
}[language];
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="brand" href={homePath} aria-label={labels.home}>
      <span class="brand__mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7.5l3 3 6-6.5" /><path d="M4 14.5l3 3 6-6.5" /><line x1="15" y1="6" x2="21" y2="6" /><line x1="15" y1="16" x2="21" y2="16" /></svg></span>
      mitlist
    </a>
    <nav class="nav__links" aria-label={labels.primary}>
      <a href={`${section}#features`}>{labels.features}</a>
      <a href={`${section}#pricing`}>{labels.pricing}</a>
      <a href={site.docsUrl}>Docs</a>
      <a href={`${section}#open`}>{labels.source}</a>
    </nav>
    <LanguageSwitcher language={language} path={languagePath} />
    <a class="btn btn--primary nav__cta" href={site.appUrl}>{labels.open}</a>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: var(--z-nav); background: var(--paper-2); border-bottom: var(--border); }
  .nav__inner { display: flex; align-items: center; gap: 1rem; min-height: 68px; }
  .brand { display: inline-flex; align-items: center; min-height: 44px; gap: .55rem; font-weight: 700; font-size: 1.25rem; letter-spacing: -.03em; text-decoration: none; color: var(--ink); }
  .brand__mark { width: 38px; height: 38px; display: grid; place-items: center; background: var(--orange); border: var(--border); box-shadow: var(--shadow-sm); }
  .brand__mark svg { width: 20px; height: 20px; fill: none; stroke: var(--ink); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .nav__links { display: flex; gap: 1.25rem; margin-left: auto; font-weight: 600; font-size: .92rem; }
  .nav__links a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--ink-3); padding-block: .65rem; border-bottom: 2px solid transparent; }
  .nav__links a:hover { color: var(--ink); border-color: var(--orange); }
  .nav__cta { min-height: 44px; padding: .6rem 1rem; font-size: .92rem; box-shadow: var(--shadow-sm); white-space: nowrap; }
  @media (max-width: 940px) { .nav__links { display: none; } .language-picker { margin-left: auto; } }
  @media (max-width: 560px) { .nav__cta { display: none; } }
</style>
