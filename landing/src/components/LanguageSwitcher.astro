---
import { languageNames, localizedPath, supportedLanguages, type SiteLanguage } from "../data/site";

interface Props { language?: SiteLanguage; path?: string; }
const { language = "en", path = "" } = Astro.props;
---

<label class="language-picker">
  <span class="visually-hidden">Language</span>
  <select aria-label="Language" data-language-picker>
    {supportedLanguages.map((code) => (
      <option value={localizedPath(code, path)} selected={code === language}>{languageNames[code]}</option>
    ))}
  </select>
</label>

<script>
  document.querySelectorAll<HTMLSelectElement>("[data-language-picker]").forEach((picker) => {
    picker.addEventListener("change", () => {
      document.cookie = `mitlist-language=${picker.value.split("/")[1]};path=/;max-age=31536000;SameSite=Lax`;
      window.location.assign(picker.value);
    });
  });
</script>

<style>
  .language-picker { display: inline-flex; }
  select { min-height: 44px; border: var(--border); border-radius: 0; padding: .55rem 2rem .55rem .7rem; background: var(--paper); color: var(--ink); font: 600 .86rem var(--font); cursor: pointer; }
</style>
