---
import "../styles/global.css";
import ConsoleEgg from "../components/ConsoleEgg.astro";
import { site, supportedLanguages, type SiteLanguage } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  language?: SiteLanguage;
  path?: string;
  image?: string;
  localized?: boolean;
  detectLanguage?: boolean;
}

const {
  title = "mitlist — one shared place for your household",
  description = "Share lists, expenses, chores, meals, calendars and notes with your household. Now in public beta on the web.",
  language = "en",
  path = "/",
  image = "/social-card.svg",
  localized = false,
  detectLanguage = false,
} = Astro.props;

const resolvedPath = path === "/" && !localized ? Astro.url.pathname : path;
const localizedUrl = resolvedPath === "/" ? `/${language}/` : `/${language}${resolvedPath}`;
const canonical = new URL(localized ? localizedUrl : resolvedPath, site.origin);
const socialImage = new URL(image, site.origin);
const skipLabel = {
  en: "Skip to content",
  de: "Zum Inhalt springen",
  es: "Saltar al contenido",
  fr: "Aller au contenu",
  nl: "Naar de inhoud",
}[language];
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f97316" />
    <link rel="canonical" href={canonical} />
    {localized && supportedLanguages.map((code) => (
      <link rel="alternate" hreflang={code} href={new URL(resolvedPath === "/" ? `/${code}/` : `/${code}${resolvedPath}`, site.origin)} />
    ))}
    {localized && <link rel="alternate" hreflang="x-default" href={new URL(resolvedPath === "/" ? "/en/" : `/en${resolvedPath}`, site.origin)} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={language} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {detectLanguage && <script is:inline>
      (() => {
        if (location.pathname !== "/") return;
        const saved = document.cookie.match(/(?:^|; )mitlist-language=([^;]+)/)?.[1];
        const supported = ["en", "de", "es", "fr", "nl"];
        const preferred = saved || navigator.languages?.map((value) => value.split("-")[0]).find((value) => supported.includes(value));
        if (preferred && preferred !== "en") location.replace(`/${preferred}/`);
      })();
    </script>}
    <!-- Cookieless aggregate page analytics for the public marketing site. -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token":"${site.analytics.cloudflareToken}"}`}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <slot />
    <ConsoleEgg />
  </body>
</html>
