---
import "../styles/global.css";
import ConsoleEgg from "../components/ConsoleEgg.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "mitlist — the shared household, in one place",
  description = "Shopping lists, shared expenses, chores, and a pinwall of notes for everyone you live with. Free at mitlist.me — open source, self-hostable, and on iOS and Android.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f97316" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Cloudflare Web Analytics: cookieless, landing page only. The app at
         app.mitlist.me deliberately carries no analytics (see PRIVACY.md). -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "cd937df3e2e24407a59ff8f4fe7d5fcf"}'></script>
  </head>
  <body>
    <slot />
    <ConsoleEgg />
  </body>
</html>
