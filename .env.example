# Root .env — docker compose variable interpolation
# ============================================
# Copy this file to .env (next to docker-compose.yml):  cp .env.example .env
#
# These values feed docker compose ${...} interpolation: the Postgres
# credentials and the backend's DATABASE_URL. This is SEPARATE from
# backend/.env (which is the app's own runtime config). A service-level
# env_file: does NOT populate compose interpolation, so these MUST live here
# (or in your shell), not in backend/.env.
#
# The defaults below are fine for local dev (docker compose up).
# For PRODUCTION (docker compose --profile prod up -d) you MUST set strong,
# unique values — the prod profile has no insecure fallback and will refuse
# to start if POSTGRES_USER / POSTGRES_PASSWORD are unset.

# DEV default below. For prod set a strong value: openssl rand -base64 24
POSTGRES_USER=mitlist
POSTGRES_PASSWORD=mitlist
POSTGRES_DB=mitlist

# Optional: set the complete managed Postgres URL (for example PlanetScale).
# When set, the production API uses this instead of the bundled database URL.
DATABASE_URL=

# Set to require if DATABASE_URL points at a REMOTE postgres (not the bundled db).
DB_SSLMODE=disable
