# Root .env — the one config file for a docker compose install
# ============================================
# Self-hosting: don't copy this by hand. Run ./scripts/selfhost-setup.sh,
# which copies it to .env and fills in the URL, strong passwords, signing keys
# and web push keys. Then edit .env for anything optional (email, S3, OAuth).
# Full guide: docs/SELF_HOSTING.md
#
# Local development: cp .env.example .env — the database defaults below work
# as they are for `docker compose --profile dev up`.
#
# This file feeds docker compose ${...} interpolation AND is loaded into the
# API container as its runtime config, so any variable from
# backend/.env.example can also go here.

# ============================================
# Database
# ============================================

# DEV defaults. A self-host must use a strong, unique password (the setup
# script generates one). Hex only: it is spliced into a connection URL.
POSTGRES_USER=mitlist
POSTGRES_PASSWORD=mitlist
POSTGRES_DB=mitlist

# Optional: a complete PostgreSQL URL for a database outside this stack. When
# set it replaces the bundled one; use DB_SSLMODE=require across a network.
DATABASE_URL=
DB_SSLMODE=disable

# Host port the bundled PostgreSQL is published on (loopback only). Change it
# if the host already runs PostgreSQL on 5432.
#POSTGRES_HOST_PORT=5432

# ============================================
# Self-host (docker compose --profile prod)
# ============================================

# Which services start on `docker compose up`: prod is the app; add https for
# the bundled Caddy with automatic certificates, scraper for FlareSolverr.
#COMPOSE_PROFILES=prod

# The public URL people open, with no trailing slash. The web app, the API
# (under /api) and invite links all live here, and the mobile apps connect to
# it ("Choose your server" on the sign-in screen). For a LAN-only install use
# the server's LAN address, e.g. http://192.168.1.20:8080.
MITLIST_URL=

# Where the web container listens on the host. 127.0.0.1 suits a reverse proxy
# on the same machine (or the bundled Caddy); 0.0.0.0 exposes it on the LAN.
MITLIST_BIND=127.0.0.1
MITLIST_PORT=8080

# Signing keys, 32+ characters each and different from each other. Changing
# them later signs everyone out. Generate with: openssl rand -hex 32
SECRET_KEY=
SESSION_SECRET_KEY=

# Email + password accounts: the sign-in a self-host needs (Google/Apple
# sign-in needs your own developer credentials; see backend/.env.example).
PASSWORD_AUTH_ENABLED=true

# Attachment quota per household in GB; 0 = unlimited (your disk, your call).
MAX_STORAGE_PER_GROUP_GB=0

# Web push notifications (browser). The setup script generates a pair; any
# VAPID generator works (raw base64url keys, not PEM).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ============================================
# Email (optional but recommended)
# ============================================
# Without email, new accounts are let in without a verification code and
# "forgot password" is unavailable. Any SMTP server or provider works.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
# starttls (port 587), tls (port 465), or none (a trusted local relay)
#SMTP_TLS=starttls
#MAIL_FROM_EMAIL=mitlist@example.com
#MAIL_FROM_NAME=mitlist

# ============================================
# Prebuilt images (optional)
# ============================================
# By default the stack builds its images from this checkout. To run published
# images instead, name them here and `docker compose pull`.
#MITLIST_IMAGE=
#MITLIST_TAG=
