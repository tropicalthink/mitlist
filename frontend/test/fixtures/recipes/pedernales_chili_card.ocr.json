{"width":1869,"height":3150,"lines":[{"text":"CAJ Ranck","bbox":[1160,980,332,153],"confidence":0.797},{"text":"Pedernales River Chili","bbox":[447,1269,1032,106],"confidence":0.98},{"text":"A favorite recipe of","bbox":[680,1408,546,74],"confidence":0.999},{"text":"Vice President and Mrs. Lyndon B. Johnson","bbox":[366,1498,1174,75],"confidence":0.994},{"text":"4 lbs. chili meat","bbox":[218,1654,464,69],"confidence":0.979},{"text":"6 tsps. chili powder","bbox":[1057,1655,538,70],"confidence":0.999},{"text":"—more if needed","bbox":[1112,1721,480,60],"confidence":0.998},{"text":"1 large onion","bbox":[214,1717,380,69],"confidence":0.997},{"text":"2 cans Ro-tel tomatoes","bbox":[1055,1777,632,70],"confidence":0.999},{"text":"2 cloves garlic","bbox":[212,1778,409,69],"confidence":1.0},{"text":"Salt to taste","bbox":[1057,1839,352,68],"confidence":0.995},{"text":"tsp, ground oregano","bbox":[268,1844,537,65],"confidence":0.972},{"text":"2 cups of hot water","bbox":[1060,1903,526,65],"confidence":1.0},{"text":"tsp. comino seed","bbox":[274,1905,455,65],"confidence":0.994},{"text":"Put chili meat, onions and garlic in large heavy","bbox":[270,2047,1420,76],"confidence":0.998},{"text":"boiler or skillet. Sear until light colored. Add oregano,","bbox":[213,2111,1480,71],"confidence":0.993},{"text":"comino, chili powder, tomatoes and hot water. Bring","bbox":[213,2174,1476,71],"confidence":0.994},{"text":"to a boil, lower heat and simmer about one hour. As fat","bbox":[214,2237,1476,66],"confidence":0.988},{"text":"cooks out—skim.","bbox":[216,2297,458,70],"confidence":0.973},{"text":"NOCHE SPECIALS","bbox":[701,2535,504,70],"confidence":1.0},{"text":"Cut tortillas into quarters and fry in deep hot fat","bbox":[273,2643,1420,71],"confidence":0.991},{"text":"until brown and crisp on both sides. Drain and put","bbox":[215,2706,1482,71],"confidence":0.997},{"text":"about one teaspoon of grated cheese and a slice of","bbox":[215,2767,1482,71],"confidence":0.991},{"text":"jalapeno pepper on each quarter. Place in hot oven until","bbox":[217,2830,1476,71],"confidence":0.996},{"text":"well heated and cheese begins to melt. Serve at once.","bbox":[216,2894,1476,67],"confidence":0.997}]}