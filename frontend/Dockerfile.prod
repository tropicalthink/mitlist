# Installable PWA (Flutter web + nginx). Set PRODUCTION_API_BASE_URL at build time
# so the app calls your API (dart-define API_BASE_URL — see lib/config/api_config.dart).
FROM ghcr.io/cirruslabs/flutter:stable AS build
WORKDIR /app
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get
COPY . .
ARG API_BASE_URL=
ARG GLITCHTIP_DSN=
ARG ENVIRONMENT=production
# Per-app intake key for the request tracker (reqtrack). Empty = the in-app
# "Send feedback" card is hidden. See lib/config/feedback_config.dart.
ARG REQTRACK_APP_KEY=
ARG REQTRACK_URL=
# Flutter does not compile web/drift_worker.dart — compile it for Drift WASM.
RUN dart compile js -O4 web/drift_worker.dart -o web/drift_worker.dart.js
RUN flutter build web --release \
    --pwa-strategy none \
    --dart-define=API_BASE_URL=${API_BASE_URL} \
    --dart-define=GLITCHTIP_DSN=${GLITCHTIP_DSN} \
    --dart-define=ENVIRONMENT=${ENVIRONMENT} \
    --dart-define=REQTRACK_APP_KEY=${REQTRACK_APP_KEY} \
    --dart-define=REQTRACK_URL=${REQTRACK_URL}

FROM nginx:1.29-alpine
COPY --from=build /app/build/web /usr/share/nginx/html
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
