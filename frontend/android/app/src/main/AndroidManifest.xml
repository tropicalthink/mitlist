<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for all builds (release included) to reach the backend API.
         Debug/profile manifests declare this separately for the Flutter tool. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The widget sync worker is expedited work, which runs as a foreground
         service before Android 12. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>

    <application
        android:label="mitlist"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- No mitlist:// filter here, on purpose. DeepLinkActivity owns
                 the whole custom scheme and forwards every link to this
                 activity. Android ignores pathPrefix on a filter without a
                 host (these URIs have none), so a second mitlist filter here,
                 however narrow its paths look, matches every link too and
                 makes Android show an app chooser listing "mitlist" twice
                 for our own OAuth redirect. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.mitlist.me" android:pathPrefix="/join" />
                <!-- Keep in step with web/.well-known/apple-app-site-association
                     and assetlinks.json: a path claimed here but missing there
                     opens the browser instead of the app. -->
                <data android:scheme="https" android:host="app.mitlist.me" android:pathPrefix="/r" />
                <!-- Buttons in the sign-up and password reset emails. -->
                <data android:scheme="https" android:host="app.mitlist.me" android:pathPrefix="/verify" />
                <data android:scheme="https" android:host="app.mitlist.me" android:pathPrefix="/reset-password" />
                <!-- The app's own sections, so the buttons in the onboarding
                     tips (and any other mail pointing at a tab) open the app
                     rather than the web app in a browser. Auth routes,
                     /auth/callback and /premium stay unclaimed on purpose:
                     the web sign-in and the Polar return page must finish in
                     the browser that started them. -->
                <data android:scheme="https" android:host="app.mitlist.me" android:pathPrefix="/home" />
                <data android:scheme="https" android:host="app.mitlist.me" android:pathPrefix="/lists" />
                <data android:scheme="https" android:host="app.mitlist.me" android:pathPrefix="/money" />
                <data android:scheme="https" android:host="app.mitlist.me" android:pathPrefix="/chores" />
                <data android:scheme="https" android:host="app.mitlist.me" android:pathPrefix="/recipes" />
                <data android:scheme="https" android:host="app.mitlist.me" android:pathPrefix="/calendar" />
                <data android:scheme="https" android:host="app.mitlist.me" android:pathPrefix="/you" />
                <data android:scheme="https" android:host="app.mitlist.me" android:pathPrefix="/scanner" />
            </intent-filter>
        </activity>
        <!-- The one activity for every mitlist:// link: the OAuth callback
             (/auth/callback), invites (/join/<code>) and shared recipes
             (/r/<token>). It forwards the link to MainActivity. singleTask so
             the OAuth redirect clears the Custom Tab out of the task instead
             of burying it under a second Flutter activity. Keep the scheme
             claimed here and nowhere else: see the note on MainActivity. -->
        <activity
            android:name=".DeepLinkActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mitlist" />
            </intent-filter>
        </activity>
        <!-- Home screen widgets, quick add and the Quick Settings tile
             (plans/047, contract C7). All Jetpack Glance or plain Android;
             none of them starts Flutter. -->
        <receiver
            android:name=".widgets.ShoppingListWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_shopping_list_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_shopping_list_info" />
        </receiver>
        <receiver
            android:name=".widgets.ChoresWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_chores_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_chores_info" />
        </receiver>
        <receiver
            android:name=".widgets.HouseholdTodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_household_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_household_today_info" />
        </receiver>
        <!-- Never on the lock screen: amounts owed are private (not_keyguard). -->
        <receiver
            android:name=".widgets.BalanceWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_balance_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_info" />
        </receiver>
        <receiver
            android:name=".widgets.QuickAddWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_add_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_add_info" />
        </receiver>
        <activity
            android:name=".widgets.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/WidgetDialogTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".widgets.QuickAddActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/quick_add_title"
            android:taskAffinity=""
            android:theme="@style/WidgetDialogTheme"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <service
            android:name=".widgets.QuickAddTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_add"
            android:label="@string/quick_add_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- The "household changed" data push (contract C6). FCM delivers
             data messages as this broadcast to every matching receiver in
             the app, FlutterFire's included, so both see it. -->
        <receiver
            android:name=".widgets.WidgetPushReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Voice input in the quick-add dialog. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH"/>
        </intent>
    </queries>
</manifest>
