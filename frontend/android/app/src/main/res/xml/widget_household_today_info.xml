<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is 0: freshness comes from the refresh push and the
     WorkManager backstop (plans/047, D6), not from the launcher's timer. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:minResizeWidth="180dp"
    android:minResizeHeight="180dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:description="@string/widget_household_today_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_preview_household_today"
    android:previewImage="@drawable/widget_preview_generic"
    android:configure="me.mitlist.widgets.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional" />
