<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer; see backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mitlist_widget_credential.xml" />
        <exclude domain="sharedpref" path="mitlist_widget_state.xml" />
        <exclude domain="file" path="widgets/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mitlist_widget_credential.xml" />
        <exclude domain="sharedpref" path="mitlist_widget_state.xml" />
        <exclude domain="file" path="widgets/" />
    </device-transfer>
</data-extraction-rules>
