<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is 0: freshness comes from the refresh push and the
     WorkManager backstop (plans/047, D6), not from the launcher's timer. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard"
    android:description="@string/widget_chores_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_preview_chores"
    android:previewImage="@drawable/widget_preview_generic"
    android:configure="me.mitlist.widgets.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional" />
