---
import { env } from "cloudflare:workers";
const APP_URL = env.APP_URL || "https://app.mitlist.me";
---

<footer class="foot">
  <div class="wrap foot__inner">
    <nav class="foot__links" aria-label="Footer">
      <a href="https://mitlist.me">mitlist.me</a>
      <a href={APP_URL}>Web app</a>
      <a href="/roadmap">Roadmap</a>
      <a href="/updates">Updates</a>
      <a href="https://github.com/whtvrboo/mitlist" rel="noopener">GitHub</a>
      <a href="https://mitlist.me/privacy">Privacy</a>
      <a href="https://mitlist.me/impressum">Impressum</a>
    </nav>
    <p class="foot__copy">
      Votes, posts and comments here are public. To keep each vote to one per browser this site sets a
      single random-id cookie the first time you vote or post, and stores nothing else about you.
      <br />Built with <img src="/tt.svg" alt="" class="foot__tt" aria-hidden="true" /> by
      <a href="https://tropicalthink.com" target="_blank" rel="noopener">tropicalthink</a> · © 2026 mitlist
    </p>
  </div>
</footer>

<style>
  .foot {
    margin-top: 4rem;
    background: var(--paper-2);
    border-top: var(--border);
    padding-block: 2rem;
  }
  .foot__inner {
    display: grid;
    gap: 1rem;
  }
  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    font-weight: 500;
    font-size: 0.93rem;
  }
  .foot__links a {
    text-decoration: none;
    color: var(--ink-3);
  }
  .foot__links a:hover {
    color: var(--ink);
  }
  .foot__copy {
    color: var(--ink-4);
    font-size: 0.86rem;
    font-weight: 500;
    max-width: 70ch;
  }
  .foot__tt {
    display: inline-block;
    width: 1.1em;
    height: 1.1em;
    vertical-align: -0.15em;
  }
</style>
