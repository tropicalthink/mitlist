# Local environment files hold real credentials (DB passwords, provider tokens)
# and must never be committed. The checked-in templates are the exception.
.env
.env.*
!.env.example
!.env.*.example

# Firebase mobile client configuration is injected by release CI. Keep local
# copies out of every repository level, including accidental root-level files.
google-services.json
GoogleService-Info.plist
**/google-services.json
**/GoogleService-Info.plist

# Python tooling and Home Assistant integration test caches.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
