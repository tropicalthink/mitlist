# Local environment files hold real credentials (DB passwords, provider tokens)
# and must never be committed. The checked-in templates are the exception.
.env
.env.*
!.env.example
!.env.*.example

# Firebase mobile client configuration is injected by release CI. Keep local
# copies out of every repository level, including accidental root-level files.
google-services.json
GoogleService-Info.plist
**/google-services.json
**/GoogleService-Info.plist

# Python tooling and Home Assistant integration test caches.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# macOS Finder metadata.
.DS_Store
**/.DS_Store

# Store listing working files: screenshots, marketing graphics and the
# generated bundles are large binaries regenerated per release, and the
# metadata under store/fastlane is uploaded from a local checkout. The
# already-tracked text listings stay tracked; nothing new is added.
store/

# On-device OCR models (~82 MB) are distributed as release assets, not in git.
# Run frontend/tool/fetch_ocr_models.py to download them; see
# frontend/assets/models/ocr/README.md.
frontend/assets/models/ocr/*/inference.onnx

# AI design-critique logs are local working notes, not project docs.
.impeccable/
**/.impeccable/
